# NEXT_PUBLIC_WORDPRESS_URL: WordPress REST API base URL (required for CMS data).
# Used by the headless WordPress API layer. Must end with /wp-json/wp/v2 (no trailing slash).
NEXT_PUBLIC_WORDPRESS_URL=https://berita-mone.mutudev.com/wp-json/wp/v2

# NEXT_PUBLIC_API_URL: The URL for the backend API (legacy, may be removed).
# On Netlify/Vercel: set this BEFORE the build and trigger a new deploy so it gets inlined.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# REVALIDATE_SECRET: Must match FRONTEND_REVALIDATE_SECRET on your Laravel/API backend exactly
# (same characters: 0 vs O, 1 vs l, etc.) so that /api/revalidate accepts webhook calls.
REVALIDATE_SECRET=your-secret-key

# News Backend API (Local Herd Environment)
NEXT_PUBLIC_NEWS_API_URL=http://berita-mone.test/api

# M-One CDN Proxy (Cloudflare Worker)
# Critical branding assets (logo, hero, about) are now served locally from
# public/images/branding. Point this to GitHub Pages or your CDN for dynamic
# assets such as portfolio/partner/blog images.
NEXT_PUBLIC_CDN_URL=https://l200160067.github.io/mone-assets

# Site base URL used in metadata/structured data. Override for production.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# WhatsApp contact number in international format without plus sign.
NEXT_PUBLIC_WHATSAPP_NUMBER=6285168850712
